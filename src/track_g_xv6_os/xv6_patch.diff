diff --git a/kernel/proc.c b/kernel/proc.c
index 959b770..8e49c71 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -124,6 +124,10 @@ allocproc(void)
 found:
   p->pid = allocpid();
   p->state = USED;
+  p->priority = 10;
+  p->stride = 1000 / 10;
+  p->pass = 0;
+  p->ticks_spent = 0;
 
   // Allocate a trapframe page.
   if((p->trapframe = (struct trapframe *)kalloc()) == 0){
@@ -441,27 +445,46 @@ scheduler(void)
   struct cpu *c = mycpu();
   c->proc = 0;
   for(;;){
-    // Avoid deadlock by ensuring that devices can interrupt.
     intr_on();
 
-    int found = 0;
-    for(p = proc; p < &proc[NPROC]; p++) {
+    // Priority & Stride Scheduler with Aging to prevent starvation
+    struct proc *best_p = 0;
+    int lowest_pass = 0x7FFFFFFF;
+
+    // Pass 1: Find runnable process with lowest pass value
+    for(p = proc; p < &proc[NPROC]; p++){
       acquire(&p->lock);
-      if(p->state == RUNNABLE) {
-        // Switch to chosen process.  It is the process's job
-        // to release its lock and then reacquire it
-        // before jumping back to us.
-        p->state = RUNNING;
-        c->proc = p;
-        swtch(&c->context, &p->context);
-
-        // Process is done running for now.
-        // It should have changed its p->state before coming back.
-        c->proc = 0;
-        found = 1;
+      if(p->state == RUNNABLE){
+        // Dynamic Aging: decrement pass for waiting processes
+        if(p->pass > 0)
+          p->pass -= 1;
+        if(p->pass < lowest_pass){
+          lowest_pass = p->pass;
+          if(best_p)
+            release(&best_p->lock);
+          best_p = p;
+          continue;
+        }
       }
       release(&p->lock);
     }
+
+    // Pass 2: Dispatch selected process
+    if(best_p != 0){
+      best_p->state = RUNNING;
+      best_p->pass += best_p->stride;
+      best_p->ticks_spent++;
+      c->proc = best_p;
+      swtch(&c->context, &best_p->context);
+      c->proc = 0;
+      release(&best_p->lock);
+    }
   }
 }
+
+int
+setpriority(int priority)
+{
+  if(priority < 1 || priority > 20)
+    return -1;
+  acquire(&myproc()->lock);
+  myproc()->priority = priority;
+  myproc()->stride = 1000 / priority;
+  release(&myproc()->lock);
+  return 0;
+}
